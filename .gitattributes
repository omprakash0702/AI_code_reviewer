# Normalize line endings to LF in the repo, checkout as-is on all platforms
* text=auto eol=lf

# Windows batch files must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
